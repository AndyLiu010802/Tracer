page { background: #101216; color: #e8eaf0; font-family: -apple-system, sans-serif; font-size: 28rpx; }
.page { padding: 32rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.title { font-size: 44rpx; font-weight: 700; margin: 12rpx 0; }
.subtitle, .muted { color: #9299a7; font-size: 25rpx; line-height: 1.7; }
.panel { background: #191d25; border: 1rpx solid #2b303b; border-radius: 20rpx; padding: 28rpx; margin: 24rpx 0; }
button { font-size: 28rpx; border-radius: 14rpx; margin: 18rpx 0; background: #262d39; color: #e8eaf0; }
button::after { border: 0; }
button.primary { background: #e5b567; color: #20190f; font-weight: 600; }
button.danger { color: #ff9d9d; }
button[disabled] { opacity: .5; color: #9299a7; }
.label { display: block; color: #b1b8c5; margin: 24rpx 0 12rpx; font-size: 25rpx; }
input, textarea, .picker { background: #202631; border: 1rpx solid #343b48; border-radius: 12rpx; padding: 22rpx; box-sizing: border-box; }
textarea { width: 100%; min-height: 180rpx; }
.notice { padding: 18rpx 22rpx; background: #322a1d; border-radius: 12rpx; color: #efd099; font-size: 24rpx; line-height: 1.7; margin: 16rpx 0; }
.error { color: #ffabab; font-size: 25rpx; line-height: 1.7; margin: 18rpx 0; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.badge { color: #e5b567; background: #352d20; padding: 5rpx 14rpx; border-radius: 9rpx; font-size: 22rpx; }
.empty { padding: 72rpx 20rpx; text-align: center; color: #9299a7; line-height: 1.8; }
.language { display: flex; flex-shrink: 0; gap: 12rpx; font-size: 24rpx; }
.language text { padding: 14rpx 12rpx; color: #9299a7; }
.language .active { color: #e5b567; background: #352d20; border-radius: 10rpx; }
