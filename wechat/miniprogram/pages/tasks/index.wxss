.tasks-page { padding-bottom: 160rpx; }
.statuses { white-space: nowrap; margin: 26rpx 0; }
.status { display: inline-block; padding: 17rpx 23rpx; margin-right: 10rpx; border-radius: 12rpx; color: #aab1bf; background: #1b2029; }
.selected { background: #39301f; color: #efd099; }
.filter { padding: 14rpx 18rpx; font-size: 25rpx; border: 1rpx solid #343b48; border-radius: 10rpx; }
.flags { margin: 20rpx 0; justify-content: flex-start; }
.task-title { font-size: 32rpx; font-weight: 600; margin: 18rpx 0; word-break: break-all; }
.task-meta { color: #a1a9b8; font-size: 24rpx; margin-top: 12rpx; }
.high { color: #ffb0a0; }
.done { color: #9299a7; }
.add-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 12rpx 32rpx calc(12rpx + env(safe-area-inset-bottom)); background: #101216; }
.add-bar button { margin: 0; }
