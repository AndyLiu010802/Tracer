<view class="page">
  <view class="row"><view class="title">{{L.syncDevices}}</view><view class="language"><text class="{{lang === 'zh' ? 'active' : ''}}" data-lang="zh" bindtap="language">中文</text><text class="{{lang === 'en' ? 'active' : ''}}" data-lang="en" bindtap="language">EN</text></view></view><view class="subtitle">{{L.syncTagline}}</view>
  <view class="notice" wx:if="{{demo}}">{{L.demoDetail}}</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="panel" wx:if="{{pending}}"><view>{{L.pending}}</view><view class="subtitle">{{L.retryHelp}}</view><button class="primary" bindtap="retry" loading="{{busy}}">{{conflicts.length ? L.mergeSave : L.retry}}</button></view>
  <view class="panel" wx:for="{{conflicts}}" wx:key="key">
    <view>{{item.title}} · {{item.fieldLabel}}</view><view class="label">{{L.phone}}: {{item.localText}}</view><view class="label">{{L.cloud}}: {{item.remoteText}}</view>
    <picker range="{{choiceLabels}}" value="{{item.selected}}" data-index="{{index}}" bindchange="choose"><view class="picker">{{item.selected === 1 ? L.keepPhone : item.selected === 2 ? L.keepCloud : L.choose}} ▾</view></picker>
  </view>
  <view class="panel"><view>{{L.bind}}</view><view class="subtitle"><view>{{L.pairStep1}}</view><view>{{L.pairStep2}}</view><view>{{L.pairStep3}}</view></view>
    <button class="primary" disabled="{{demo || busy}}" loading="{{busy}}" bindtap="generate">{{L.generate}}</button>
    <view wx:if="{{code}}"><text class="label" selectable>{{code}}</text><view class="muted">{{expires}}</view><button bindtap="copy">{{L.copy}}</button></view>
  </view>
  <view class="label">{{L.devices}}</view>
  <view class="empty" wx:if="{{!devices.length}}">{{L.noDevices}}</view>
  <view class="panel" wx:for="{{devices}}" wx:key="id"><view>{{item.name}}</view><view class="muted">{{item.dateLabel}}</view><button class="danger" data-id="{{item.id}}" bindtap="revoke">{{L.revoke}}</button></view>
  <view class="subtitle">{{L.syncFootnote}}</view>
</view>
